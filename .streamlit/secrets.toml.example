# Copy this file to .streamlit/secrets.toml and fill in local values.
# Do not commit .streamlit/secrets.toml.
#
# Key roles:
# - supabase.key          = publishable/anon key for Supabase Auth only
#                           (email/password create-account + sign-in)
# - supabase.service_key  = service_role key for server-side student-data helpers
#                           Never expose this key to the browser or Auth client.
#
# Google OAuth continues to use the [auth] / [auth.google] Streamlit settings.

admin_emails = [
    ""
]

[supabase]
url = ""
key = ""
service_key = ""

[auth]
expose_tokens = ["id"]
redirect_uri = ""
cookie_secret = ""
# Required so Google sign-in can exchange the OIDC ID token for a Supabase
# Auth session. Canonical student ownership uses Supabase user.id only.
expose_tokens = ["id"]
# Optional dedicated secret for email "keep me signed in" cookies.
# If omitted, cookie_secret is used. Prefer a long random string.
# You can also set SP_AUTH_PERSIST_SECRET in the environment.
persist_secret = ""

[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
